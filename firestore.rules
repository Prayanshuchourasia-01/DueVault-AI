rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user is an admin
    // We check the custom users document for the isAdmin flag
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 1. User Profiles and Subcollections
    match /users/{userId} {
      // User can read and write their own profile; Admins can read/write any profile
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Match all subcollections for this user (tasks, routines, finances, history_logs, config)
      match /{document=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Gemini Audit Logs (gemini_logs)
    match /gemini_logs/{logId} {
      // Users can create logs (when they make an API request)
      allow create: if isAuthenticated();
      // Only admins can read, update, or delete logs
      allow read, update, delete: if isAdmin();
    }

    // 3. Admin Configuration (admin/config)
    match /admin/{document=**} {
      // Allow read/write to anyone if the document doesn't exist yet (for initial setup)
      // Otherwise, only admins can read or write
      allow read, write: if !exists(/databases/$(database)/documents/admin/config) || isAdmin();
    }

    // 4. Global Config (config/demo_html)
    match /config/{document=**} {
      // Anyone authenticated can read global configs
      allow read: if isAuthenticated();
      // Only admins can write
      allow write: if isAdmin();
    }

    // 5. Rate Limiting Tracker
    match /rate_limits/{userId} {
      // Only the specific user can read/write their own rate limit document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Enforce the rate limit cooldown rule:
      // The user can only create a new document, OR update it if 2 seconds have passed since the last write.
      allow write: if isAuthenticated() && request.auth.uid == userId && (
        !exists(/databases/$(database)/documents/rate_limits/$(userId)) ||
        !("lastRequestTime" in get(/databases/$(database)/documents/rate_limits/$(userId)).data) ||
        request.time > get(/databases/$(database)/documents/rate_limits/$(userId)).data.lastRequestTime + duration.value(2, 's')
      );
    }
  }
}
